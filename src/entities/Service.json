{
  "name": "Service",
  "type": "object",
  "properties": {
    "service_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "default_price": {
      "type": "number",
      "description": "Default price for this service"
    },
    "category": {
      "type": "string",
      "enum": [
        "maintenance",
        "repair",
        "inspection",
        "tire_service",
        "emergency",
        "other"
      ],
      "default": "maintenance"
    },
    "estimated_duration": {
      "type": "number",
      "description": "Estimated duration in hours"
    }
  },
  "required": [
    "service_name",
    "default_price"
  ]
}