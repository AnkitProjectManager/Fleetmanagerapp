{
  "name": "roll-charge-fleet-manager-backend",
  "version": "1.0.0",
  "description": "Roll and Charge Fleet Manager Portal - Complete Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
  "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
  "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:seed": "node scripts/database.js seed",
    "db:seed:fresh": "node scripts/database.js seed --clear",
    "db:clear": "node scripts/database.js clear",
    "db:status": "node scripts/database.js status"
  },
  "keywords": [
    "roll",
    "charge",
    "fleet",
    "management",
    "portal",
    "electric",
    "vehicle",
    "api",
    "express",
    "nodejs"
  ],
  "author": "Roll and Charge Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "commander": "^11.1.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
